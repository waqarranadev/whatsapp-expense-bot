NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# MongoDB (Atlas, or local via docker-compose: mongodb://localhost:27017/expense_bot)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# Optional. Set if you get "querySrv ECONNREFUSED" (Node can't read the Windows DNS server)
DNS_SERVERS=1.1.1.1,8.8.8.8

# WhatsApp (whatsapp-web.js)
# Path to your installed Chrome (puppeteer's own Chrome download is skipped)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Session name in MongoDB (RemoteAuth). Change it to link a different WhatsApp account.
WA_CLIENT_ID=expense-bot
# How often the session is backed up to MongoDB (min 60000)
WA_BACKUP_SYNC_MS=300000
# Comma-separated numbers the bot will answer (digits only, e.g. 923001234567). Empty = everyone.
WA_ALLOWED_NUMBERS=

# Defaults for new users
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR

# AI: any OpenAI-compatible endpoint (needed from phase 2)
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Redis (later, for the BullMQ queue)
# REDIS_URL=redis://localhost:6379
